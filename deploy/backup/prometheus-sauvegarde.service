# Sauvegarde nocturne de la base de production (ADR-0015).
# Installation (une fois, en tant que ops) :
#   sudo cp prometheus-sauvegarde.service prometheus-sauvegarde.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now prometheus-sauvegarde.timer
# Lancer à la main : sudo systemctl start prometheus-sauvegarde.service
# Journal         : journalctl -u prometheus-sauvegarde.service

[Unit]
Description=Sauvegarde chiffrée de la base de production vers Backblaze B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/prometheus
ExecStart=/usr/bin/docker compose run --rm --no-deps backup
