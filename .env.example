# Modèle des variables d'environnement. Copier en .env.local (jamais versionné)
# et remplacer les valeurs. Aucune vraie valeur ne doit apparaître dans ce fichier.

# Adresse de la branche Neon `dev` (avec le pooler), jamais celle de la production.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-EXEMPLE-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Better Auth (ADR-0016). Secret : au moins 32 caractères aléatoires, différent par environnement.
BETTER_AUTH_SECRET=REMPLACER_PAR_32_CARACTERES_ALEATOIRES_OU_PLUS
BETTER_AUTH_URL=http://localhost:3000

# Facultatif en local : sans clé Resend, les liens de connexion s'affichent dans le terminal.
# RESEND_API_KEY=
