{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Paris",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 3,
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "Outillage de lint et de formatage : une seule PR groupée",
      "matchPackageNames": ["eslint", "eslint-config-*", "typescript-eslint", "prettier"],
      "groupName": "lint et formatage"
    },
    {
      "description": "Next.js et React évoluent ensemble",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "next et react"
    },
    {
      "description": "typescript-eslint impose une plage de TypeScript : pas de montée majeure automatique",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
